<% layout("layout/boilerplate") -%>
<body>
    <h3>Create a new Listing</h3>
    <form method="post" action="/listings">
        <input placeholder="Enter title" name="listing[title]" type="text">
        <br>
        <br>
        <textarea placeholder="Enter description" name="listing[description]"></textarea>
        <br>
        <br>
        <input placeholder="Enter image URL/Link" name="listing[image]" type="text">
        <br>
        <br>
        <input placeholder="Enter price" name="listing[price]" type="number">
        <br>
        <br>
        <input placeholder="Enter location" name="listing[location]" type="text">
        <br>
        <br>
        <input placeholder="Enter country name" name="listing[country]" type="text">
        <br>
        <br>
        <button>Add</button>
    </form>
</body>
